---
// src/components/VantaBackground.astro
---

<div
  id="vanta-bg"
  style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;"
>
</div>

<script>
  declare global {
    interface Window {
      __vantaEffect: any;
    }
  }

  let effect: any = null;

  async function initVanta() {
    try {
      // Cleanup existing effect if it exists
      if (effect) {
        effect.destroy();
        effect = null;
      }

      const vantaContainer = document.querySelector("#vanta-bg");
      if (!vantaContainer) return;

      // Dynamic imports
      const THREE = await import("three");
      // @ts-ignore - Vanta DOTS requires global THREE
      window.THREE = THREE;
      // @ts-ignore - Vanta doesn't have built-in types for its distribution files
      const vantaModule = await import("vanta/dist/vanta.dots.min");
      const DOTS = vantaModule.default;

      // Initialize Vanta
      effect = DOTS({
        el: "#vanta-bg",
        THREE: THREE,
        mouseControls: true,
        touchControls: true,
        gyroControls: false,
        minHeight: 200.0,
        minWidth: 200.0,
        scale: 1.0,
        scaleMobile: 1.0,
        color: 0xf59e0b, // Amber to match your gradient
        backgroundColor: 0x000000,
        showLines: true,
        spacing: 24.0,
      });

      window.__vantaEffect = effect;
    } catch (error) {
      console.error("Vanta failed to load:", error);
    }
  }

  // Run on initial load and after every navigation
  document.addEventListener("astro:page-load", initVanta);

  // Optional: cleanup before swapping pages
  document.addEventListener("astro:before-swap", () => {
    if (effect) {
      effect.destroy();
      effect = null;
    }
  });
</script>
