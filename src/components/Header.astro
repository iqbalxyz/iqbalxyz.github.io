---
// import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Experience",
    label: "experience",
    url: "/#experience",
  },
  {
    title: "Projects",
    label: "projects",
    url: "/#projects",
  },
  {
    title: "Skills",
    label: "skills",
    url: "/#skills",
  },
  {
    title: "About",
    label: "about-me",
    url: "/#about-me",
  },
  {
    title: "Contact",
    label: "contact",
    url: "/#contact",
  },
];
---

<!-- hide header while scroll only for mobile -->
<header
  id="main-header"
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4 transition-transform duration-300"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-xl text-white/70 justify-center items-center border border-white/10"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative block px-3 py-1.5 rounded-xl transition-colors duration-200 hover:text-amber-400"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <!-- <div class="ml-2 pl-2 border-l border-white/10">
      <ThemeToggle />
    </div> -->
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-amber-400", "bg-amber-400/10");
              item.classList.remove("text-white/70");
            } else {
              item.classList.remove("text-amber-400", "bg-amber-400/10");
              item.classList.add("text-white/70");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };

    let lastScrollY = window.scrollY;
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", () => {
      // Only apply logic on mobile screens (optional - md is 768px)
      if (window.innerWidth < 768) {
        if (window.scrollY > lastScrollY && window.scrollY > 50) {
          // Scrolling Down - Hide Header
          header?.classList.add("-translate-y-full", "hidden");
        } else {
          // Scrolling Up - Show Header
          header?.classList.remove("-translate-y-full", "hidden");
        }
      }
      lastScrollY = window.scrollY;
    });
  });
</script>

<style>
  .header-nav {
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .header-nav {
    @apply bg-black/40 backdrop-blur-md;
  }

  .nav-link.text-amber-400 {
    @apply font-semibold;
  }

  @keyframes nav-appear {
    0% {
      @apply bg-black/0 border-transparent shadow-none;
    }
    to {
      @apply shadow-2xl ring-1 backdrop-blur-xl ring-white/10 border-white/10;
    }
  }
</style>
