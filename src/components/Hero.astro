---
const personalImageAlt = "Iqbal";
import Badge from "@/components/Badge.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import DownloadIcon from "@/components/icons/DownloadIcon.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div class="w-full">
  <div class="anim-fade-in flex gap-4 mb-6 mt-6 items-center">
    <!-- Avatar with ambient glow -->
    <div class="relative flex-shrink-0">
      <div
        class="absolute inset-0 rounded-full bg-amber-400/30 blur-xl scale-125"
        aria-hidden="true"
      >
      </div>
      <img
        class="relative rounded-full shadow-2xl size-28 ring-2 ring-amber-400/60 ring-offset-2 ring-offset-black"
        src="/me.jpeg"
        alt={personalImageAlt}
      />
    </div>
    <a
      href="/Moch_Iqbal_Sudrajat_CV.pdf"
      download="Moch_Iqbal_Sudrajat_CV.pdf"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge class="flex items-center">
        <DownloadIcon class="size-3 mr-2" /> Download CV
      </Badge>
    </a>
  </div>

  <h1
    class="anim-fade-in anim-delay-1 text-4xl font-bold tracking-tight text-white sm:text-5xl"
  >
    Hello World, I'm <span class="gradient-name">Iqbal</span>
  </h1>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-white/95 [&>strong]:text-amber-400 [&>strong]:font-semibold"
  >
    I'm a Full-Stack Engineer with 5 years of experience, specializing in
    backend and frontend development. I started my career in application
    support, which gave me a strong foundation in understanding production
    issues and user needs. Now, I focus on building scalable and maintainable
    software using technologies like Node.js, React, Next.js, and TypeScript.
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Social networks and contact"
  >
    <SocialPill href="mailto:moch.iqbal.sudrajat@gmail.com">
      <MailIcon class="size-4" />
      Contact Me
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/moch-iqbal-sudrajat-7aa976223/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/iqbalxyz">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
