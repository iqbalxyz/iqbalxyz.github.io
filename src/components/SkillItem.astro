---
import SkillIcon from "./icons/skills/SkillIcon.astro";

export interface Props {
  name: string;
  level: string;
  icon: string;
}

const { name, level, icon } = Astro.props;
---

<div
  class="group flex items-center gap-4 p-4 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-amber-500/50 hover:bg-white/10 transition-all duration-300 shadow-lg hover:shadow-amber-500/10 hover:scale-[1.02]"
>
  <!-- SVG Icon -->
  <div class="flex-shrink-0 w-12 h-12">
    <SkillIcon icon={icon} class="w-full h-full" />
  </div>

  <!-- Skill Info -->
  <div class="flex-1">
    <h3 class="text-lg font-semibold text-white">
      {name}
    </h3>
    <div class="mt-1">
      <span
        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20"
      >
        {level}
      </span>
    </div>
  </div>

  <!-- Optional: Level indicator bar -->
  <div class="hidden sm:block w-32">
    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden">
      <div
        class="h-full bg-gradient-to-r from-amber-600 to-amber-400 rounded-full transition-all duration-700 group-hover:scale-x-105 origin-left"
        style={`width: ${
          level === "Beginner"
            ? "33%"
            : level === "Intermediate"
              ? "66%"
              : level === "Advanced"
                ? "100%"
                : "50%"
        }`}
      >
      </div>
    </div>
  </div>
</div>
