---
import { type CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description}>
  <main class="px-4">
    <SectionContainer class="py-24">
      <a
        href="/#blog"
        class="inline-flex items-center gap-2 text-amber-500 hover:text-amber-400 transition-colors mb-8 group"
      >
        <ArrowRight class="size-4 rotate-180 transition-transform group-hover:-translate-x-1" />
        Back to blog
      </a>

      <article class="prose prose-invert prose-amber max-w-none">
        <header class="mb-12">
          <div class="flex flex-wrap gap-2 mb-4">
            {entry.data.tags.map((tag) => (
              <span class="text-xs font-medium px-2 py-1 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20 uppercase tracking-wider">
                {tag}
              </span>
            ))}
          </div>
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
            {entry.data.title}
          </h1>
          <time class="text-gray-400">
            {entry.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </header>

        {entry.data.image && (
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="w-full aspect-video object-cover rounded-2xl mb-12 border border-gray-800"
          />
        )}

        <div class="content text-gray-200 leading-relaxed">
          <Content />
        </div>
      </article>
    </SectionContainer>
  </main>
</Layout>

<style is:global>
  .content {
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .content h1 {
    display: none; /* Already in header */
  }
  .content h2 {
    color: white;
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }
  .content h3 {
    color: white;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .content p {
    margin-bottom: 1.5rem;
    color: #d1d5db;
  }
  .content ul, .content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: #d1d5db;
  }
  .content ul {
    list-style-type: disc;
  }
  .content ol {
    list-style-type: decimal;
  }
  .content li {
    margin-bottom: 0.5rem;
  }
  .content strong {
    color: white;
    font-weight: 600;
  }
  .content pre {
    background: rgba(17, 24, 39, 0.5);
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid rgba(31, 41, 55, 1);
    margin-bottom: 1.5rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .content code {
    color: #fbbf24; /* amber-400 */
    background: rgba(245, 158, 11, 0.1);
    padding-left: 0.375rem;
    padding-right: 0.375rem;
    padding-top: 0.125rem;
    padding-bottom: 0.125rem;
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }
  .content pre code {
    color: #e5e7eb;
    background: transparent;
    padding: 0;
  }
  .content blockquote {
    border-left-width: 4px;
    border-left-color: #f59e0b; /* amber-500 */
    padding-left: 1.5rem;
    font-style: italic;
    color: #9ca3af;
    margin-bottom: 1.5rem;
  }
  .content img {
    border-radius: 1rem;
    margin-bottom: 1.5rem;
  }
</style>
